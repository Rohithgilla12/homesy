DATABASE_URL=postgres://homesy:homesy@localhost:5432/homesy
# generate with: openssl rand -hex 32  — keep real values in 1Password, never in chat or git
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080
RUST_LOG=homesy_api=debug,tower_http=info

# Attachments (optional). Create the bucket and an R2 API token in the Cloudflare dashboard; keep values in 1Password.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=homesy-attachments
# S3_ENDPOINT=http://localhost:9000   # only for MinIO in tests
