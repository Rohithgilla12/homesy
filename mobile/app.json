{
  "expo": {
    "name": "Homesy",
    "slug": "homesy",
    "scheme": "homesy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.homesy.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.homesy.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F6F5F1"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Homesy uses your photos for receipts, documents and notes.",
          "cameraPermission": "Homesy uses the camera for receipts, documents and notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "25bd70bf-aa77-46f6-acca-530f8c2b69ac"
      }
    },
    "owner": "gilladude",
    "icon": "./assets/icon.png"
  }
}
